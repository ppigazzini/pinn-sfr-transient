# Generated artifacts: `pinn-sfr reference` rebuilds results/ (figure + .npz) on
# demand and the CLI recreates the directory, so the binaries are not tracked.
/results/

# The transient charts are DRAWN, never committed. `paper.yml` regenerates them from
# the physics on every build, so a figure in the PDF is always the current model's --
# a committed PNG is a number that stops tracking the code that produced it, which is
# the same failure mode AGENTS.md records for tables. Rebuild with
# `python -m pinn_sfr_transient.axial.charts`.
/docs/img/charts/

# Scratch / pasted logs (e.g. CI run logs saved locally)
*.log

# Concatenation of the mirrored manual chapters, written by
# `tools/fetch_sas_manual.py --combined`. It duplicates docs/sas4a/ChNN.txt
# exactly and exceeds the 1 MB file limit.
/docs/sas4a/ALL.txt

# Local working notes.
/__DEV/
